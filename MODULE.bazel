module(name = "loophole", version = "0.1.0")

bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "package_metadata", version = "0.0.7")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")
register_toolchains("@python_3_12//:all")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "loophole_pip",
    python_version = "3.12",
    requirements_lock = "//:requirements-bazel.txt",
)
use_repo(pip, "loophole_pip")
